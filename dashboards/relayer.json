       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "wideLayout": true
   },
   "description": "Number of relayer wallets whose native (gas) balance is below the per-chain minimum. Should be 0."
