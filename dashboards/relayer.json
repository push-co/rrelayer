   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "ddz2le6n8pypsa"
     },
     "editorMode": "code",
     "expr": "count((relayer_native_balance{env=\"$env\", namespace=\"$namespace\"}) < on(chain_id) group_left() (relayer_native_min_balance{env=\"$env\", namespace=\"$namespace\"})) or vector(0)",
